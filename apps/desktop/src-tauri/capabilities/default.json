{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main Ignit desktop window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:4321/*",
      "https://ignit.ignit677.workers.dev/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "window-state:default"
  ]
}
