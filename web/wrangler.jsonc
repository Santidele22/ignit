{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ignit-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-26",
  "vars": {
    "BACKEND_URL": "https://ignit-api.onrender.com",
    "NEON_AUTH_BASE_URL": ""
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "vars": {
        "BACKEND_URL": "http://localhost:3000",
        "NEON_AUTH_BASE_URL": ""
      }
    }
  }
}
