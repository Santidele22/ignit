---
/**
 * Shell HTML autónomo de la Sala de lectura (`/biblioteca`, S1/S2).
 *
 * Espeja el `<head>` de `BaseLayout.astro` (metadatos, fuentes self-hosted,
 * `ThemeScript`) pero reemplaza el chrome de la app por el de «Sala de
 * lectura»: `body.biblioteca-body` (el único consumidor de
 * `features/library/styles/biblioteca.css`), la grilla atmosférica de fondo y
 * el `skip-link` al contenido. La topbar, el hero y los paneles los renderiza
 * `BibliotecaApp` (SolidJS) dentro del `<slot />`.
 *
 * CSP: no hay ningún `<script is:inline>` acá. Toda la interacción viaja en el
 * módulo empaquetado de `BibliotecaApp`, así que no suma hashes nuevos a
 * `script-src 'self'`.
 */
import { Font } from 'astro:assets';
import SessionGuard from '../../features/auth/SessionGuard';
import ThemeScript from '../../shared/ui/ThemeScript.astro';
import { SITE_AUTHOR, SITE_NAME } from '../config/site';
import '../styles/global.css';
import '../../features/library/styles/biblioteca.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `Mi biblioteca — ${SITE_NAME}`,
	description = 'Tu sala de lectura: continuá donde quedaste, descargá libros para leer sin conexión y seguí tus aportes al catálogo de Ignit.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* PWA shell metadata (S3): the dark blue-black chrome of the sala, its
		    manifest and the apple-touch-icon. `/biblioteca` is the install entry
		    point (`start_url`); the Service Worker registers from `BibliotecaApp`. */}
		<meta name="theme-color" content="#04050a" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Ignit" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<meta name="author" content={SITE_AUTHOR} />
		<title>{title}</title>
		<Font cssVariable="--font-shippori" preload />
		<Font cssVariable="--font-zen" preload />
		<Font cssVariable="--font-geist-mono" />
		<ThemeScript />
	</head>
	<body class="biblioteca-body">
		<a class="skip-link" href="#main-content">Saltar al contenido</a>
		<div class="bg-grid" aria-hidden="true"></div>
		<SessionGuard client:load />
		<slot />
	</body>
</html>
