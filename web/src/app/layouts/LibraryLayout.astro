---
import { Font } from 'astro:assets';
import HeaderAuth from '../../features/auth/HeaderAuth';
import SessionGuard from '../../features/auth/SessionGuard';
import { getServerSession, type ServerSession } from '../../features/auth/api/serverSession';
import ThemeScript from '../../shared/ui/ThemeScript.astro';
import PaletteToggle from '../../shared/ui/PaletteToggle.astro';
import { SITE_NAME } from '../config/site';
import '../styles/global.css';

interface Props {
	title: string;
	session?: ServerSession;
}

const { title, session: providedSession } = Astro.props;
const session = providedSession ?? (await getServerSession(Astro.request.headers.get('cookie')));
const userLabel = session.authenticated ? session.user.name || session.user.email : '';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<Font cssVariable="--font-shippori" preload />
		<Font cssVariable="--font-zen" preload />
		<Font cssVariable="--font-geist-mono" />
		<ThemeScript />
	</head>
	<body class="bg-background font-sans text-foreground antialiased">
		<SessionGuard client:load />
		<div class="flex min-h-dvh flex-col">
			<header class="sticky top-0 z-30 border-b border-border bg-background/95 backdrop-blur-sm">
				<div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-x-4 gap-y-2 px-5 py-2 sm:h-16 sm:px-8 sm:py-0">
					<a href="/" class="flex items-center gap-2.5">
						<span class="hanko size-8 rounded-[5px] font-mono text-[11px]" aria-hidden="true">IG</span>
						<span class="text-left leading-none">
							<span class="block font-mincho text-lg font-semibold tracking-tight">{SITE_NAME}</span>
							<span class="block text-[9px] tracking-[0.35em] text-muted-foreground">BIBLIOTECA</span>
						</span>
					</a>
					<nav class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 text-sm sm:gap-x-6" aria-label="Biblioteca">
						<a href="/" class="text-muted-foreground transition-colors hover:text-aka">Explorar catálogo</a>
						{session.authenticated && <HeaderAuth label={userLabel} client:load />}
						<PaletteToggle />
					</nav>
				</div>
			</header>
			<main class="flex-1 px-4 py-10 sm:px-8 lg:py-12">
				<div class="mx-auto flex max-w-6xl flex-col gap-8">
					<slot />
				</div>
			</main>
		</div>
	</body>
</html>
