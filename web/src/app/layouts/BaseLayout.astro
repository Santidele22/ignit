---
import { Font } from 'astro:assets';
import HeaderAuth from '../../features/auth/HeaderAuth';
import { getServerSession, type ServerSession } from '../../features/auth/api/serverSession';
import ThemeScript from '../../shared/ui/ThemeScript.astro';
import PaletteToggle from '../../shared/ui/PaletteToggle.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../config/site';
import '../styles/global.css';

interface Props {
	noindex?: boolean;
	title?: string;
	description?: string;
	session?: ServerSession;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	noindex = false,
	session: providedSession,
} = Astro.props;

const session = providedSession ?? (await getServerSession(Astro.request.headers.get('cookie')));
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const userLabel = session.authenticated ? session.user.name || session.user.email : '';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" href="/favicon.ico?v=2" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="view-transition" content="same-origin" />
		<meta name="author" content={SITE_AUTHOR} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={SITE_NAME} />
		<title>{title}</title>
		<Font cssVariable="--font-shippori" preload />
		<Font cssVariable="--font-zen" preload />
		<Font cssVariable="--font-geist-mono" />
		<ThemeScript />
	</head>
	<body class="bg-background font-sans text-foreground antialiased">
		<div class="flex min-h-dvh flex-col">
			<header class="sticky top-0 z-30 border-b border-border bg-background/95 backdrop-blur-sm">
				<div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-x-4 gap-y-2 px-5 py-2 sm:h-16 sm:px-8 sm:py-0">
					<a href="/" class="flex items-center gap-2.5">
						<span class="hanko size-8 rounded-[5px] font-mono text-[11px]" aria-hidden="true">IG</span>
						<span class="font-mincho text-lg font-semibold tracking-tight">{SITE_NAME}</span>
					</a>
					<nav class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 text-sm sm:gap-x-6" aria-label="Navegación principal">
						<a href="/" class="text-muted-foreground transition-colors hover:text-aka">Explorar</a>
						<a href="/biblioteca" class="text-muted-foreground transition-colors hover:text-aka">Mi biblioteca</a>
						<PaletteToggle />
						{session.authenticated ? (
							<HeaderAuth label={userLabel} client:load />
						) : (
							<div class="flex items-center gap-2.5">
								<a href="/login" class="px-2 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-aka">
									Entrar
								</a>
								<a
									href="/registro"
									class="rounded-sm bg-foreground px-3 py-1.5 text-xs font-medium text-background transition-colors hover:bg-aka hover:text-aka-foreground"
								>
									Crear cuenta
								</a>
							</div>
						)}
					</nav>
				</div>
			</header>
			<main class="flex-1">
				<slot />
			</main>
			<footer class="border-t border-border py-8 text-center text-xs text-muted-foreground">
				<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 sm:px-8">
					<span>{SITE_NAME} · Lectura inmersiva en modo Vigilia</span>
					<nav class="flex flex-wrap items-center gap-x-4 gap-y-1" aria-label="Enlaces legales">
						<a href="/terminos" class="transition-colors hover:text-aka">Términos</a>
						<a href="/privacidad" class="transition-colors hover:text-aka">Privacidad</a>
						<a href="/dmca" class="transition-colors hover:text-aka">Derechos de autor / DMCA</a>
					</nav>
				</div>
			</footer>
		</div>
	</body>
</html>
