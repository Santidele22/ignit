---
import { SITE_DESCRIPTION, SITE_NAME } from '../app/config/site';
import LandingLayout from '../app/layouts/LandingLayout.astro';
import { getServerSession } from '../features/auth/api/serverSession';
import { fetchBooksPage } from '../features/book/api/books';
import CatalogSection from '../features/landing/components/CatalogSection.astro';
import ClosingSection from '../features/landing/components/ClosingSection.astro';
import HeroSection from '../features/landing/components/HeroSection.astro';
import JourneySection from '../features/landing/components/JourneySection.astro';
import PipelineSection from '../features/landing/components/PipelineSection.astro';
import ReaderEmbedSection from '../features/landing/components/ReaderEmbedSection.astro';
import { buildShelfLayout } from '../features/landing/lib/catalog';
import { defaultEmbedPath } from '../features/landing/lib/embed';
import { parseOffset } from '../shared/api/pagination';

const PAGE_SIZE = 8;
const rawKind = Astro.url.searchParams.get('kind');
const activeKind = rawKind === 'tecnico' || rawKind === 'no_tecnico' ? rawKind : undefined;
const offset = parseOffset(Astro.url.searchParams.get('offset'));
const serverOrigin = Astro.url.origin;

const [page, session] = await Promise.all([
	fetchBooksPage(serverOrigin, offset, PAGE_SIZE, true, activeKind),
	getServerSession(Astro.request.headers.get('cookie')),
]);

const books = page?.items ?? null;
const shelfBooks = books ?? [];
const shelfLayout = buildShelfLayout(shelfBooks);
const totalBooks = page?.total ?? 0;
const embedPath = defaultEmbedPath(shelfBooks);
const defaultBookTitle = shelfBooks.find((book) => book.published)?.title;
---

<LandingLayout
	title={`${SITE_NAME} — Biblioteca inmersiva y modo Vigilia`}
	description={SITE_DESCRIPTION}
	session={session}
>
	<HeroSection
		totalBooks={totalBooks}
		shelfLayout={shelfLayout}
		authenticated={session.authenticated}
	/>
	<CatalogSection
		books={books}
		total={totalBooks}
		offset={page?.offset ?? offset}
		limit={PAGE_SIZE}
		activeKind={activeKind}
	/>
	<PipelineSection />
	<ReaderEmbedSection
		defaultPath={embedPath}
		defaultBookTitle={defaultBookTitle}
	/>
	<JourneySection />
	<ClosingSection authenticated={session.authenticated} />
</LandingLayout>

<script>
	import { initLanding } from '../features/landing/client/initLanding';

	initLanding();
</script>
