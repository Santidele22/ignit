---
import BibliotecaLayout from '../app/layouts/BibliotecaLayout.astro';
import { isAdminSession } from '../features/admin/lib/admin-access';
import { getServerSession, type ServerSession } from '../features/auth/api/serverSession';
import { fetchBooks, fetchMyBooksServer } from '../features/book/api/books';
import BibliotecaApp from '../features/library/components/BibliotecaApp';

const cachedSession = (Astro.locals as unknown as { serverSession?: ServerSession }).serverSession;
const session = cachedSession ?? (await getServerSession(Astro.request.headers.get('cookie')));
const serverOrigin = Astro.url.origin;

const authOptions = session.authenticated
	? { serverOrigin, bearerToken: session.bearerToken, cookie: session.cookie }
	: undefined;

const [ownedBooks, catalogBooks] = await Promise.all([
	authOptions ? fetchMyBooksServer(authOptions) : Promise.resolve(null),
	fetchBooks(serverOrigin),
]);

const userId = session.authenticated ? (session.user.id ?? session.user.email) : 'anon';
const userLabel = session.authenticated
	? session.user.email || session.user.name || 'lector'
	: '';
const isAdmin = session.authenticated && isAdminSession(session.user);
---

<BibliotecaLayout title="Mi biblioteca — Ignit">
	<BibliotecaApp
		client:load
		userId={userId}
		userLabel={userLabel}
		isAdmin={isAdmin}
		initialOwnedBooks={ownedBooks ?? []}
		initialCatalogBooks={catalogBooks ?? []}
		ssrOwnedLoaded={ownedBooks !== null}
		ssrCatalogLoaded={catalogBooks !== null}
	/>
</BibliotecaLayout>
