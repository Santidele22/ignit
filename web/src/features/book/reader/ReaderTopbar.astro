---
import { safeExternalUrl } from '../api/books';

interface Props {
	title: string | null;
	author: string | null;
	initialPage: number;
	initialPct: number;
	backHref?: string;
	backLabel?: string;
	canSync?: boolean;
	loginHref?: string;
	hasFicha?: boolean;
	ctaLabel?: string | null;
	ctaUrl?: string | null;
}

const {
	title,
	author,
	initialPage,
	initialPct,
	backHref = '/',
	backLabel = '← explorar',
	canSync = false,
	loginHref = '/login',
	hasFicha = false,
	ctaLabel = null,
	ctaUrl = null,
} = Astro.props;
const safeCtaUrl = safeExternalUrl(ctaUrl) ?? null;
---

	<header class="topbar" id="topbar">
		<a class="crumb" id="topBackLink" href={backHref}>{backLabel}</a>
		<div class="ident">
			<h1>{title ?? 'Vigilia de lectura'}</h1>
			<p>{author ?? 'No encontrado'}</p>
		</div>
		<div
			class="prog"
			id="progSummary"
			aria-label={`Progreso de lectura: página ${initialPage}, ${initialPct} por ciento`}
		>
			{hasFicha && (
				<button
					class="crumb topbar-ficha-btn"
					id="fichaBtn"
					type="button"
					aria-expanded="false"
					aria-controls="fichaDeck"
				>
					Ficha
				</button>
			)}
			{safeCtaUrl && (
				<a
					class="crumb topbar-cta-link"
					href={safeCtaUrl}
					target="_blank"
					rel="noopener noreferrer"
					data-cta-track="1"
				>
					{ctaLabel?.trim() || 'Apoyar / Tienda'} ↗
				</a>
			)}
			{!canSync && title && (
				<a class="crumb" href={loginHref} title="Iniciá sesión para sincronizar progreso entre dispositivos">
					Sincronizar progreso
				</a>
			)}
			<span class="top-timer-pill" id="topTimerPill" hidden aria-live="off">
				<i class="timer-dot" aria-hidden="true"></i>
				<span id="topTimerClock">00:00</span>
			</span>
			<span class="pg">PÁG <b id="progPage">{initialPage}</b> · <span id="progTotalPages">…</span></span>
			<span class="wire" aria-hidden="true"><i id="progWire"></i></span>
			<span class="pct" id="progPct">{initialPct}%</span>
		</div>
	</header>
