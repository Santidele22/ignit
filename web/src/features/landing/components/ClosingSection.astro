---
/**
 * Sección VI · Cierre + footer de la landing (S7).
 *
 * El bloque final resume la propuesta (instalar una vez, descargar sólo lo que
 * se lee) y cierra con las mismas CTAs que el resto de la página, adaptadas a la
 * sesión: con cuenta manda a la biblioteca personal, sin cuenta invita a
 * crearla.
 */
interface Props {
	authenticated: boolean;
}

const { authenticated } = Astro.props;
---

<section class="capa" data-capa id="s6">
	<div class="anim">
		<div class="cierre-box">
			<p class="num">VI · empezar</p>
			<span class="sello" aria-hidden="true">熒</span>
			<h2>
				Instalá una vez.<br /><span class="azu">Descargá solo lo que leés.</span>
			</h2>
			<p class="lead">
				App liviana sin tiendas ni ruido. Catálogo curado por categoría, lectura offline y progreso sincronizado
				entre tus dispositivos.
			</p>
			<div class="acciones">
				<button class="cta" type="button" data-pwa-install data-pwa-install-only>
					Instalar app
				</button>
				<a class="cta" href="#s2">Explorar catálogo</a>
				{
					authenticated ? (
						<a class="cta-sec" href="/biblioteca">
							Ir a mi biblioteca
						</a>
					) : (
						<a class="cta-sec" href="/registro">
							Crear cuenta
						</a>
					)
				}
				<a class="quiet" href="/biblioteca">Subir un libro</a>
			</div>

			<div class="desktop-install-panel" id="desktop-installer">
				<p class="desktop-install-eyebrow">App Desktop nativa · Tauri v2 (v0.1.0)</p>
				<div class="desktop-install-head">
					<div>
						<h3>Ignit para escritorio</h3>
						<p class="desktop-install-sub">
							Ventana dedicada, caché offline local y atajos de lectura en Vigilia (`F11`, `Ctrl + / -`).
						</p>
					</div>
					<a
						class="cta"
						href="/downloads/Ignit_0.1.0_amd64.deb"
						download="Ignit_0.1.0_amd64.deb"
					>
						Descargar Linux (.deb · 4.9 MB)
					</a>
				</div>

				<div class="desktop-os-grid">
					<article class="desktop-os-card is-ready">
						<span class="desktop-os-badge">Disponible</span>
						<h4>Linux (x86_64)</h4>
						<p>Ubuntu, Debian, Linux Mint, Pop!_OS (`.deb`) y `.AppImage` portable para cualquier distro.</p>
					</article>
					<article class="desktop-os-card">
						<span class="desktop-os-badge">En camino</span>
						<h4>Windows (x64)</h4>
						<p>Instalador `.msi` sobre WebView2 (Windows 10 / 11). Configuración Tauri v2 lista.</p>
					</article>
					<article class="desktop-os-card">
						<span class="desktop-os-badge">En camino</span>
						<h4>macOS (Universal)</h4>
						<p>Paquete `.dmg` nativo para Apple Silicon e Intel. Configuración Tauri v2 lista.</p>
					</article>
				</div>

				<div class="desktop-install-steps">
					<p class="desktop-steps-title">Cómo instalar en Linux</p>
					<ol>
						<li>
							<strong>Debian / Ubuntu / Mint (`.deb`):</strong> descargá el paquete y ejecutá
							<code>sudo apt install ./Ignit_0.1.0_amd64.deb</code>. Agrega el ícono al menú automáticamente.
						</li>
						<li>
							<strong>Cualquier distribución (`.AppImage`):</strong> dale permisos de ejecución con
							<code>chmod +x Ignit_0.1.0_amd64.AppImage &amp;&amp; ./Ignit_0.1.0_amd64.AppImage</code>.
						</li>
					</ol>
				</div>
			</div>
		</div>
	</div>
</section>

<footer class="landing-footer">
	<span>Ignit — biblioteca comunitaria · modo vigilia</span>
	<span>
		<a href="#s2">catálogo</a> · <a href="#s3">publicar</a> · <a href="#s4">vigilia</a> ·
		{authenticated ? <a href="/biblioteca">mi biblioteca</a> : <a href="/login">entrar</a>} ·
		<a href="/terminos">términos</a> · <a href="/privacidad">privacidad</a> · <a href="/dmca">dmca</a>
	</span>
</footer>
