---
/**
 * Sección II · «Elegí tu estancia de lectura»: las dos salas + estante (S1/S4).
 *
 * Todo el estado inicial es server-rendered y real: el conteo del medidor de
 * dispositivo, los filtros activos (`activeKind` de la URL), el índice de
 * búsqueda normalizado de cada libro, el peso en KB (`fileSize` cuando existe,
 * estimación cuando no) y el enlace directo al lector real `/lecturas/:id`.
 *
 * Las dos tarjetas de sala y la fila de disciplinas son una vista sobre el
 * filtro de categorías que ya existía: los chips son los mismos
 * `.chip[data-filtro]` (valores de `BookKind`, uno por categoría real del
 * catálogo) y las tarjetas sólo piden al runtime que active el chip por defecto
 * de su sala (`data-estancia`), nunca un estado paralelo.
 *
 * El marcado también declara los nodos que `initLanding.ts` necesita
 * (`#catSearch`, `.chip[data-filtro]`, `.tomo`, `.btn-dl`, `#dlCount`,
 * `#dlBar`, `#catEmptySearch`); por eso no hay `<script is:inline>`.
 */
import { formatLicenseBadge } from '../../../entities/book/open-licenses';
import { type Book, type BookKind } from '../../../entities/book/types';
import PaginationControls from '../../../shared/ui/PaginationControls.astro';
import {
	bookSearchIndex,
	bookSizeKb,
	buildSalaChips,
	computeOfflineMeter,
	countSalaBooks,
	coverVariantIndex,
	formatSizeKb,
	kindLabel,
	SALA_KINDS,
	type SalaId,
} from '../lib/catalog';
import BookCoverArt from './BookCoverArt.astro';

interface Props {
	/** Published books for the current page, or `null` when the API failed. */
	books: Book[] | null;
	total: number;
	offset: number;
	limit: number;
	activeKind?: BookKind;
}

const { books, total, offset, limit, activeKind } = Astro.props;

const unreachable = books === null;
const items = books ?? [];

/* The artboard starts its offline preview with two downloads; we mirror that
   with the first two books of the page so the KB meter is never a lie. */
const previewBooks = items.slice(0, 2);
const meter = computeOfflineMeter(previewBooks.map((book) => bookSizeKb(book)));
const meterLabel = previewBooks.length === 0 ? '0 libros · 0 KB' : meter.label;
const initialOfflineIds = new Set(previewBooks.map((book) => book.id));

/* The two rooms are a view over the real kinds and count only the books this
   page actually fetched, so the badge can never overstate the shelf. */
const salaCounts = countSalaBooks(items);
const salaBadge = (count: number) =>
	`${count} ${count === 1 ? 'tomo' : 'tomos'} en esta página`;
const salas: Array<{ id: SalaId; num: string; name: string; caption: string }> = [
	{
		id: 'estudio',
		num: 'Dominio I',
		name: 'Estudio Profesional',
		caption: 'Ingeniería, computación, derecho, medicina, economía y diseño',
	},
	{
		id: 'despeje',
		num: 'Dominio II',
		name: 'Despeje Literario',
		caption: 'Filosofía, ficción, terror clásico, historia y poesía universal',
	},
];

const basePath = activeKind ? `/?kind=${activeKind}` : '/';
const indexLabel = (position: number) => String(position).padStart(2, '0');
---

<section class="capa" data-capa id="s2">
	<div class="anim">
		<p class="num">II · las dos salas</p>
		<div class="cat-head">
			<div>
				<h2>Elegí tu <span class="azu">estancia de lectura.</span></h2>
				<p class="lead">
					El catálogo público reúne exclusivamente obras en dominio público y licencias abiertas (Creative Commons,
					documentación técnica open source y libros libres), listas para leer en Vigilia o descargar offline.
				</p>
			</div>
			<div class="device-meter" aria-live="polite">
				<div class="device-meter-row">
					<span>En este dispositivo (preview)</span>
					<b id="dlCount">{meterLabel}</b>
				</div>
				<div class="meter-bar"><i id="dlBar" style={`width:${meter.barPercent}%`}></i></div>
			</div>
		</div>

		<div class="estancias" role="group" aria-label="Elegir sala de lectura">
			{
				salas.map((sala) => (
					<div
						class="estancia"
						data-estancia={sala.id}
						data-activa={activeKind !== undefined && SALA_KINDS[sala.id].includes(activeKind) ? 'true' : 'false'}
					>
						<a
							class="estancia-head"
							href="#rejilla"
							data-sala-head={sala.id}
							aria-label={`${sala.name}: ${sala.caption}. Abrir la sala y filtrar el estante.`}
						>
							<span class="estancia-copy">
								<span class="domain-num">{sala.num}</span>
								<span class="domain-name">{sala.name}</span>
								<span class="domain-caption">{sala.caption}</span>
							</span>
							<span class="domain-badge">{salaBadge(salaCounts[sala.id])}</span>
						</a>
						<div class="estancia-filtros" role="group" aria-label={`Filtros de ${sala.name}`}>
							{buildSalaChips(sala.id).map((filtro) => (
								<button
									class="chip"
									data-filtro={filtro.value}
									data-sala={sala.id}
									data-activa={activeKind !== undefined && activeKind === filtro.value ? 'true' : 'false'}
									aria-pressed={activeKind !== undefined && activeKind === filtro.value ? 'true' : 'false'}
									type="button"
								>
									{filtro.label}
								</button>
							))}
						</div>
					</div>
				))
			}
		</div>

		<div class="cat-controls">
			<input
				class="cat-search"
				id="catSearch"
				type="search"
				placeholder="Buscar título, autor o disciplina…"
				aria-label="Buscar en el catálogo"
			/>
		</div>

		{
			unreachable && (
				<div class="cat-empty-box" id="catEmptyCatalog" role="status">
					<span class="tag">api sin respuesta</span>
					<h3>No pudimos abrir el catálogo ahora mismo</h3>
					<p>
						La API no respondió. Tu biblioteca sigue disponible y podés reintentar en unos segundos.
					</p>
					<div class="acciones">
						<a class="cta" href="/biblioteca">
							Ir a mi biblioteca
						</a>
						<a class="quiet" href={Astro.url.pathname}>
							Reintentar
						</a>
					</div>
				</div>
			)
		}

		{
			books !== null && items.length === 0 && (
				<div class="cat-empty-box" id="catEmptyCatalog" role="status">
					<span class="tag">catálogo vacío</span>
					<h3>Todavía no hay libros publicados</h3>
					<p>
						Creá una cuenta y subí tu primer PDF: después de pasar seguridad, extracción y control de formato, tu
						libro aparece en esta estantería.
					</p>
					<div class="acciones">
						<a class="cta" href="/biblioteca">
							Subir un libro
						</a>
						<a class="quiet" href="/registro">
							Crear cuenta
						</a>
					</div>
				</div>
			)
		}

		{
			items.length > 0 && (
				<>
					<div class="rejilla" id="rejilla">
						{items.map((book, index) => {
							const sizeKb = bookSizeKb(book);
							const offline = initialOfflineIds.has(book.id);
							const licenseBadge = formatLicenseBadge(book.license);
							return (
								<article
									class="tomo"
									data-kind={book.kind}
										data-sala={SALA_KINDS.estudio.includes(book.kind) ? 'estudio' : 'despeje'}
									data-kb={sizeKb}
									data-offline={offline ? 'true' : 'false'}
									data-search={bookSearchIndex(book)}
								>
									<a class="tomo-tapa" href={`/lecturas/${book.id}`}>
										{book.coverUrl ? (
										<img class="tomo-cover-img" src={book.coverUrl} alt="" loading="lazy" />
									) : (
										<BookCoverArt variant={coverVariantIndex(book.id)} bookId={book.id} />
									)}
										<div class="tomo-top">
											<span class="tomo-idx">{indexLabel(offset + index + 1)}</span>
											<span class="tomo-badge">{offline ? 'offline ✓' : 'nube'}</span>
										</div>
										<div class="tomo-copy">
											<div class="tomo-editorial">{book.statusLabel}</div>
											<div class="tomo-titulo">{book.title}</div>
											<div class="tomo-autor">{book.author}</div>
										</div>
									</a>
									<div class="tomo-foot">
										<div class="tomo-meta">
											<span class="cat">{kindLabel(book.kind)}</span>
											{licenseBadge && (
												<span class="lic" title={`Licencia: ${book.license ?? licenseBadge}`}>
													{licenseBadge}
												</span>
											)}
											<span class="peso">{formatSizeKb(sizeKb)}</span>
										</div>
										<button class="btn-dl" type="button" aria-pressed={offline ? 'true' : 'false'}>{
											offline ? 'Quitar' : '↓ Descargar'
										}</button>
									</div>
								</article>
							);
						})}
					</div>

					<div class="cat-empty-box" id="catEmptySearch" hidden aria-live="polite">
						<span class="tag">sin resultados</span>
						<h3>Ningún libro coincide con tu búsqueda</h3>
						<p>Probá con otro título u autor, o volvé al filtro «Todos» para ver el catálogo completo.</p>
					</div>

					{
						total > limit && (
							<div class="cat-pagination">
								<PaginationControls basePath={basePath} total={total} offset={offset} limit={limit} />
							</div>
						)
					}
				</>
			)
		}
	</div>
</section>
