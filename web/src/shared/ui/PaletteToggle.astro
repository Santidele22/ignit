---
/**
 * Selector compacto de paleta con metáfora de libro abierto para el header
 * global (`noche-azul` vs `original`).
 *
 * El propio contenedor es un libro abierto de dos páginas con lomo central:
 * - Página izquierda (`noche-azul`): lectura nocturna (luna creciente).
 * - Página derecha (`original`): papel cálido (sol minimalista).
 * Un indicador deslizante con cinta señaladora recorre de una página a la otra
 * al alternar el modo.
 *
 * Mantiene el contrato compartido con `initPaletteControls()` (`data-palette-option`,
 * `aria-pressed`, `data-on`) y `<script>` empaquetado bajo `script-src 'self'`.
 */
---

<div
	role="group"
	aria-label="Paleta de colores"
	class="book-toggle"
>
	<span class="book-toggle-page" aria-hidden="true"></span>
	<span class="book-toggle-spine" aria-hidden="true"></span>

	<button
		type="button"
		data-palette-option="noche-azul"
		aria-pressed="true"
		data-on="true"
		aria-label="Noche azul — lectura nocturna"
		title="Noche azul (lectura nocturna)"
		class="book-toggle-btn book-toggle-btn--left"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 20 20"
			class="book-toggle-icon"
			fill="none"
			stroke="currentColor"
			stroke-width="1.65"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M13.8 11.9A5.4 5.4 0 0 1 8.1 6.2a5.5 5.5 0 1 0 5.7 5.7Z" />
			<path d="M14.5 4.2v2M13.5 5.2h2" stroke-width="1.4" />
		</svg>
	</button>

	<button
		type="button"
		data-palette-option="original"
		aria-pressed="false"
		data-on="false"
		aria-label="Original — papel cálido"
		title="Original (papel cálido)"
		class="book-toggle-btn book-toggle-btn--right"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 20 20"
			class="book-toggle-icon"
			fill="none"
			stroke="currentColor"
			stroke-width="1.65"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="10" cy="10" r="3.2" />
			<path d="M10 3.2v1.6M10 15.2v1.6M3.2 10h1.6M15.2 10h1.6M5.2 5.2l1.1 1.1M13.7 13.7l1.1 1.1M14.8 5.2l-1.1 1.1M6.3 13.7l-1.1 1.1" />
		</svg>
	</button>
</div>

<style>
	.book-toggle {
		position: relative;
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		flex-shrink: 0;
		width: 74px;
		height: 36px;
		padding: 3px;
		border-radius: 7px 7px 8px 8px;
		border: 1px solid var(--border);
		background: color-mix(in srgb, var(--card) 92%, transparent);
		box-shadow:
			inset 0 -2px 0 color-mix(in srgb, var(--border) 70%, transparent),
			0 1px 2px rgb(0 0 0 / 0.16);
		isolation: isolate;
	}

	/* Pliegue central del libro abierto */
	.book-toggle-spine {
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 50%;
		width: 1px;
		transform: translateX(-0.5px);
		background: linear-gradient(
			to bottom,
			transparent,
			color-mix(in srgb, var(--border) 95%, var(--foreground) 12%) 22%,
			color-mix(in srgb, var(--border) 95%, var(--foreground) 12%) 78%,
			transparent
		);
		box-shadow:
			-2px 0 4px rgb(0 0 0 / 0.18),
			2px 0 4px rgb(0 0 0 / 0.18);
		pointer-events: none;
		z-index: 2;
	}

	/* Página iluminada que se desliza de izquierda a derecha */
	.book-toggle-page {
		position: absolute;
		top: 3px;
		bottom: 4px;
		left: 3px;
		width: calc(50% - 3px);
		border-radius: 4px 2px 2px 5px;
		background: var(--aka);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.24),
			0 1px 3px rgb(0 0 0 / 0.22);
		transition:
			transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
			border-radius 240ms ease,
			background-color 200ms ease;
		pointer-events: none;
		z-index: 1;
	}

	/* Micro cinta señaladora en el borde superior de la página activa */
	.book-toggle-page::after {
		content: '';
		position: absolute;
		top: -3px;
		left: 50%;
		width: 6px;
		height: 5px;
		transform: translateX(-50%);
		background: color-mix(in srgb, var(--aka) 82%, var(--foreground) 18%);
		clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 68%, 0 100%);
		opacity: 0.9;
	}

	.book-toggle:has([data-palette-option='original'][aria-pressed='true']) .book-toggle-page {
		transform: translateX(100%);
		border-radius: 2px 4px 5px 2px;
	}

	.book-toggle-btn {
		position: relative;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--muted-foreground);
		cursor: pointer;
		transition:
			color 180ms ease,
			transform 180ms ease;
	}

	.book-toggle-btn--left {
		border-radius: 4px 2px 2px 5px;
	}

	.book-toggle-btn--right {
		border-radius: 2px 4px 5px 2px;
	}

	.book-toggle-btn:hover {
		color: var(--foreground);
	}

	.book-toggle-btn[aria-pressed='true'] {
		color: var(--aka-foreground);
	}

	.book-toggle-btn[aria-pressed='true']:hover {
		color: var(--aka-foreground);
	}

	.book-toggle-btn:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	.book-toggle-icon {
		width: 15px;
		height: 15px;
		flex-shrink: 0;
		transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.book-toggle-btn[aria-pressed='true'] .book-toggle-icon {
		transform: scale(1.06);
	}

	@media (prefers-reduced-motion: reduce) {
		.book-toggle-page,
		.book-toggle-btn,
		.book-toggle-icon {
			transition: none;
		}
	}
</style>

<script>
	import { initPaletteControls } from '../lib/palette';

	initPaletteControls();
</script>
