---
/**
 * Selector compacto de paleta para el header global (noche-azul palette S5).
 *
 * Dos únicas fuentes de verdad, ambas compartidas con el deck del lector:
 * `data-palette-option` en cada botón e `initPaletteControls()` de
 * `shared/lib/palette`. El marcado ya refleja el estado por defecto
 * (`noche-azul`), así que no hay parpadeo antes de que corra el script; el
 * script sólo re-sincroniza con la preferencia guardada y cablea los clics,
 * incluida la sincronización entre pestañas y entre controles.
 *
 * El `<script>` va empaquetado (sin `is:inline`) a propósito: Astro lo sirve
 * como módulo propio bajo `script-src 'self'`, así que no hay que sumar ningún
 * hash de CSP nuevo en `astro.config.mjs`.
 */
---

<div
	role="group"
	aria-label="Paleta de colores"
	class="inline-flex shrink-0 items-center gap-1 rounded-full border border-border bg-card p-1"
>
	<button
		type="button"
		data-palette-option="noche-azul"
		aria-pressed="true"
		data-on="true"
		aria-label="Noche azul — lectura nocturna"
		title="Noche azul (lectura nocturna)"
		class="inline-flex size-8 items-center justify-center rounded-full text-muted-foreground transition-all hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-pressed:bg-aka aria-pressed:text-aka-foreground aria-pressed:hover:text-aka-foreground"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 20 20"
			class="size-4 shrink-0"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M2.5 7.5C5 6.3 7.8 6.6 10 8v8.2c-2.2-1.4-5-1.7-7.5-.5V7.5Z" />
			<path d="M17.5 7.5C15 6.3 12.2 6.6 10 8v8.2c2.2-1.4 5-1.7 7.5-.5V7.5Z" />
			<path d="M11.8 2.4a2.3 2.3 0 0 0 2.7 2.7 2.4 2.4 0 1 1-2.7-2.7Z" />
		</svg>
	</button>
	<button
		type="button"
		data-palette-option="original"
		aria-pressed="false"
		data-on="false"
		aria-label="Original — papel cálido"
		title="Original (papel cálido)"
		class="inline-flex size-8 items-center justify-center rounded-full text-muted-foreground transition-all hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring aria-pressed:bg-aka aria-pressed:text-aka-foreground aria-pressed:hover:text-aka-foreground"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 20 20"
			class="size-4 shrink-0"
			fill="none"
			stroke="currentColor"
			stroke-width="1.6"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M2.5 7.5C5 6.3 7.8 6.6 10 8v8.2c-2.2-1.4-5-1.7-7.5-.5V7.5Z" />
			<path d="M17.5 7.5C15 6.3 12.2 6.6 10 8v8.2c2.2-1.4 5-1.7 7.5-.5V7.5Z" />
			<circle cx="10" cy="3.6" r="1.4" />
			<path d="M10 1v.6M6.8 2.2l.4.4M13.2 2.2l-.4.4" />
		</svg>
	</button>
</div>

<script>
	import { initPaletteControls } from '../lib/palette';

	initPaletteControls();
</script>
