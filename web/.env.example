# Base URL de la API. `/api` usa el proxy de Vite en desarrollo y el Worker en producción.
PUBLIC_API_BASE_URL=/api

# Origen del backend para el proxy SSR `/api/*`.
BACKEND_URL=http://localhost:3000

# Managed Better Auth (Neon Auth) en producción para proxy same-origin de `/api/auth/*`.
NEON_AUTH_BASE_URL=
