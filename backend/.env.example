# Server port
PORT=3000

# PostgreSQL connection string (Neon pooled in prod, local Docker in dev)
DATABASE_URL=postgres://app:app@localhost:5432/ignit
DATABASE_URL_UNPOOLED=postgres://app:app@localhost:5432/ignit

# Data store selector: dev (SQLite), dev-neon (Neon branch), prod (Neon main, synchronize off)
DB_MODE=dev
SQLITE_DATABASE=database.sqlite
DB_SYNCHRONIZE=true

# Auth stack: unset/better (Better Auth with public sign-up), neon (Neon Auth JWT), dev (interim dev login)
AUTH_MODE=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Interim dev auth credentials (only needed when AUTH_MODE=dev)
ADMIN_EMAIL=dev@ignit.local
ADMIN_PASSWORD=dev-password-change-me
ADMIN_NAME=Ignit Dev
DEV_SESSION_SECRET=replace-with-a-long-random-dev-secret
DEV_SESSION_TTL=604800

# Postgres Docker password
POSTGRES_PASSWORD=app

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-32-character-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_CROSS_SITE=
CORS_ORIGINS=

# Proxy hop count behind Astro/Cloudflare SSR proxy
TRUST_PROXY_HOPS=1

# PDF storage (`local` or `s3` for Cloudflare R2 / Backblaze B2 / Neon Object Storage)
BOOKS_STORAGE=local
BOOKS_UPLOAD_DIR=uploads/books
BOOKS_DOWNLOAD_URL_TTL=120
BOOKS_S3_BUCKET=ignit-books
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
